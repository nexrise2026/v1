# ==============================================================================
# NIRVAHA AI — Backend Environment Configuration
# Copy this file to .env or configure keys securely via your deployment Secrets.
# NEVER expose secret keys in frontend code or commit real keys to version control.
# ==============================================================================

# 1. Gemini API (Intelligent AI chatbot, scheme recommendations, problem analysis, eligibility)
# Obtain from: https://aistudio.google.com/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 2. Sarvam AI (Indian language voice STT, TTS, and translation)
# Obtain from: https://dashboard.sarvam.ai/
SARVAM_API_KEY="YOUR_SARVAM_API_KEY"

# 3. Supabase (User authentication, chat history, user profiles, government scheme DB)
# Obtain from: https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL="YOUR_SUPABASE_URL"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
SUPABASE_SECRET_KEY="YOUR_SUPABASE_SECRET_KEY"

# 4. Google Maps Platform (Places API (New) for nearby government offices & Routes API for directions)
# Obtain from: https://console.cloud.google.com/google/maps-apis/credentials
# Enable: "Places API (New)" and "Routes API"
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# 5. Bhashini / ULCA (Indian language speech recognition & translation)
# Obtain from: https://bhashini.gov.in/ulca -> Profile -> My Profile (API Key / User ID)
BHASHINI_API_KEY="YOUR_BHASHINI_API_KEY"
# Optional: Provide BHASHINI_USER_ID if using ULCA dynamic pipeline discovery
BHASHINI_USER_ID=""
BHASHINI_PIPELINE_ID="64392f96daac500b55c543cd"

# Application URL (injected at runtime in hosted environments)
APP_URL="http://localhost:3000"
